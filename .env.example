# 账户配置
# 账号顺序即 NS_COOKIE 的槽位顺序（位置即身份），严格按下表对应：
#   第 1 个账号  ->  USER  / PASS
#   第 2 个账号  ->  USER1 / PASS1
#   第 3 个账号  ->  USER2 / PASS2
#   ...
# USER1 起必须连续：遇到第一个缺失的序号即停止后面的账号。
# 注意：只配置了 USER1/PASS1（没有 USER/PASS）时，USER1 就是第 1 个账号。
# 下面默认给出"第 1 个账号用 USER/PASS"的写法；若你的既有配置是用 USER1
# 开头的，请保持 USER/PASS 注释状态，否则所有账号都会整体后移一位。
# USER=your_username
# PASS=your_password
# USER1=your_username1
# PASS1=your_password1

# --- 验证码配置 (二选一) ---
# 只有 Cookie 明确失效时才会触发登录和验证码求解。

# 方案A: 自建 CloudFreed 服务
SOLVER_TYPE=turnstile
API_BASE_URL=http://127.0.0.1:3000
# CLIENT_KEY=your_cloudfreed_client_key

# 方案B: YesCaptcha 服务
# SOLVER_TYPE=yescaptcha
# # YesCaptcha 国内节点: https://cn.yescaptcha.com, 国际节点: https://api.yescaptcha.com
# API_BASE_URL=https://api.yescaptcha.com
# CLIENT_KEY=your_yescaptcha_client_key

# 功能配置
# 传给签到接口的 random 查询参数，原样使用
NS_RANDOM=false

# 已有 Cookie；支持 & 或换行分隔。空槽位（&&）表示该账号没有 Cookie，不能省略。
# 注意：不要把真实 Cookie 提交到 Git。
# 注意：IN_DOCKER=true 时该变量被忽略，Cookie 只从 cookie/NS_COOKIE.txt 读取。
# NS_COOKIE=cookie1&cookie2

# 每日运行时间配置
# 支持固定时间 (例如 '09:00') 或随机时间范围 (例如 '08:00-10:59')
# 如果不设置，默认为 '09:00-21:00'；格式错误时回退 '08:00-10:59'
# RUN_AT=09:00-21:00

# 请求与重试
TIMEOUT=15
# 调试模式（可能输出敏感上下文，默认关闭）
# DEBUG=false
# 主指纹及 Cloudflare 挑战时的最大尝试次数（1-5）
NS_IMPERSONATE=chrome146
NS_IMPERSONATE_ATTEMPTS=3
# 每次运行最多重新登录次数，默认等于账号数与 Cookie 数中的较大者；可按需设置上限
# MAX_LOGIN_ATTEMPTS=3
# 签到统计最多查询页数（1-20）。默认 20 页，与历史行为一致，
# 确保 30 天窗口不被静默截断；若显式调低，统计结果会标注为"数据不完整"。
STATS_MAX_PAGES=20

# 调度器
# 签到子进程最长运行时间（秒）
TASK_TIMEOUT=1800
# 休眠分段检查间隔（秒），用于响应系统时间变化和停止信号
SCHEDULER_SLEEP_CHUNK=60
HEARTBEAT_FILE=./cookie/heartbeat
# SCHEDULER_LOCK_FILE=./cookie/scheduler.lock

# GitHub Actions Cookie 加密回写（默认关闭）
# 开启后需要 GH_PAT 具备目标仓库 Secrets 写权限
GH_COOKIE_WRITEBACK=false
# GH_PAT=
# GITHUB_REPOSITORY=owner/repo

# 通知配置
# 可用 NOTIFY_CONFIG_JSON 一次性传入所有通知渠道配置，避免逐个映射
# NOTIFY_CONFIG_JSON={"TG_BOT_TOKEN":"...","TG_USER_ID":"..."}
NOTIFY_THREAD_TIMEOUT=30
# 一言后缀（默认开启）；CONSOLE=true 额外输出到控制台
# HITOKOTO=true
# CONSOLE=false
# 跳过标题完全匹配的通知，多个标题用换行分隔
# SKIP_PUSH_TITLE=
# TG_BOT_TOKEN=
# TG_USER_ID=
# TG_THREAD_ID=

# 模拟 Docker 环境，用于本地测试（会从 cookie/NS_COOKIE.txt 读取 Cookie）
# IN_DOCKER=true
